# All optional. Set these as environment variables (the app does not read this file by itself).
DATABASE_PATH=learning.db        # where the SQLite file lives
COOKIE_SECURE=1                  # set when the site is served over HTTPS
ADMIN_KEY=change-me              # enables GET /api/class/overview (send it as the X-Admin-Key header)
ANTHROPIC_API_KEY=               # optional: lets the AI engine top up practice questions (verified before use)
